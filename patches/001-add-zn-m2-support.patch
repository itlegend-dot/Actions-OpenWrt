diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6018-zn-m2.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6018-zn-m2.dts
new file mode 100644
index 0000000000..8a7f1d2c3b
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6018-zn-m2.dts
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include "ipq6018.dtsi"
+#include "ipq6018-nand.dtsi"
+
+/ {
+	model = "Zhaoneng ZN-M2";
+	compatible = "zhaoneng,zn-m2", "qcom,ipq6018";
+
+	aliases {
+		serial0 = &blsp1_uart1;
+		led-boot = &led_system;
+		led-failsafe = &led_system;
+		led-upgrade = &led_system;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_system: system {
+			label = "green:system";
+			gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+};
+
+&blsp1_uart1 {
+	status = "okay";
+};
+
+&qpic_nand {
+	status = "okay";
+
+	nand@0 {
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x0 0x100000>;
+				read-only;
+			};
+
+			partition@100000 {
+				label = "0:MIBIB";
+				reg = <0x100000 0x100000>;
+				read-only;
+			};
+
+			partition@200000 {
+				label = "0:QSEE";
+				reg = <0x200000 0x200000>;
+				read-only;
+			};
+
+			partition@400000 {
+				label = "0:CDT";
+				reg = <0x400000 0x100000>;
+				read-only;
+			};
+
+			partition@500000 {
+				label = "0:APPSBLENV";
+				reg = <0x500000 0x40000>;
+				read-only;
+			};
+
+			partition@540000 {
+				label = "ubi";
+				reg = <0x540000 0x7ac0000>;
+			};
+		};
+	};
+};
+
+&mdio {
+	status = "okay";
+};
+
+&gmac0 {
+	status = "okay";
+	phy-mode = "sgmii";
+	phy-handle = <&phy0>;
+};
diff --git a/target/linux/qualcommax/image/ipq60xx.mk b/target/linux/qualcommax/image/ipq60xx.mk
index 1234567890..abcdef1234 100644
--- a/target/linux/qualcommax/image/ipq60xx.mk
+++ b/target/linux/qualcommax/image/ipq60xx.mk
@@ -123,3 +123,15 @@ define Device/cmiot_ax18
   IMAGE_SIZE := 123392k
 endef
 TARGET_DEVICES += cmiot_ax18
+
+define Device/zhaoneng_zn-m2
+  $(call Device/FitImageLzma)
+  DEVICE_VENDOR := Zhaoneng
+  DEVICE_MODEL := ZN-M2
+  SOC := ipq6018
+  DEVICE_PACKAGES := kmod-qca8075 kmod-ath11k-ahb ath11k-firmware-ipq6018
+  BLOCKSIZE := 128k
+  PAGESIZE := 2048
+  UBINIZE_OPTS := -E 5
+  IMAGES += factory.bin
+  IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE)
+  IMAGE_SIZE := 123392k
+endef
+TARGET_DEVICES += zhaoneng_zn-m2
diff --git a/target/linux/qualcommax/ipq60xx/base-files/etc/board.d/02_network b/target/linux/qualcommax/ipq60xx/base-files/etc/board.d/02_network
index abcdef1234..567890abcd 100755
